{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ai-live2d-maker:generated-character:2",
  "type":"object","additionalProperties":false,
  "required":["format","version","canvas","coordinates","sides","preview","background","template","scope","rigged","appearance_quality_passed","generator","design","blueprint","groups","parts","rig_geometry"],
  "properties":{
    "format":{"const":"ai-live2d-generated-character"},"version":{"const":2},"template":{"const":"front-bust-design-v1"},
    "canvas":{"type":"object","required":["width","height"],"properties":{"width":{"const":768},"height":{"const":1024}}},
    "coordinates":{"const":"canvas-pixels-top-left"},"sides":{"const":"character-personal-left-right"},"preview":{"const":"preview.png"},"background":{"enum":["transparent","white","lavender"]},
    "scope":{"type":"object","required":["pose","crop","costume","expression","person_count"],"properties":{"pose":{"const":"front"},"crop":{"const":"bust"},"costume":{"enum":["classic-maid","cafe-maid"]},"expression":{"const":"neutral"},"person_count":{"const":1}}},
    "rigged":{"const":false},"appearance_quality_passed":{"const":false},
    "generator":{"type":"object","required":["id","version","ai_generated","recipe","design_id","blueprint_id","provenance"],"properties":{
      "id":{"const":"local-design-v1"},"version":{"const":1},"ai_generated":{"const":false},"recipe":{"$ref":"urn:ai-live2d-maker:character-design:1"},"design_id":{"$ref":"#/$defs/hash"},"blueprint_id":{"$ref":"#/$defs/hash"},
      "provenance":{"type":"object","required":["method","model","external_request","anatomy_reference"],"properties":{"method":{"const":"local-parametric-svg"},"model":{"type":"null"},"external_request":{"const":false},"anatomy_reference":{"const":"maid-bust-front-v1"}}}}},
    "design":{"$ref":"urn:ai-live2d-maker:character-design:1"},
    "blueprint":{"type":"object","required":["format","version","design_id","parts","groups","rig_geometry","joins","palette","style","provider_policy"],"properties":{"format":{"const":"ai-live2d-character-blueprint"},"version":{"const":1},"design_id":{"$ref":"#/$defs/hash"},"parts":{"$ref":"#/$defs/parts"},"rig_geometry":{"$ref":"#/$defs/rig"}}},
    "groups":{"type":"array","minItems":8,"maxItems":16,"items":{"type":"object","required":["id","parent","anchor"]}},
    "parts":{"$ref":"#/$defs/parts"},"rig_geometry":{"$ref":"#/$defs/rig"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "parts":{
      "type":"array","minItems":33,"maxItems":33,
      "items":{"allOf":[
        {"$ref":"urn:ai-live2d-maker:generated-character:1#/$defs/part"},
        {"type":"object","required":["generation"],"properties":{
          "generation":{"type":"object","required":["design_id","source_role","reference_transform","complete_layer","completion","occluded_by"],"properties":{
            "design_id":{"$ref":"#/$defs/hash"},
            "reference_transform":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"number"}},
            "complete_layer":{"const":true},"completion":{"const":"draw-full-hidden-anatomy"},
            "occluded_by":{"type":"array","items":{"type":"string"}}
          }}
        }}
      ]}
    },
    "rig":{"type":"object","required":["head_pivot","neck_follow_y","neck_fixed_y","head_x","head_y","head_tilt"],"properties":{"head_pivot":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},"neck_follow_y":{"type":"number","minimum":0,"maximum":1024},"neck_fixed_y":{"type":"number","minimum":0,"maximum":1024},"head_x":{"type":"number","exclusiveMinimum":0,"maximum":16},"head_y":{"type":"number","exclusiveMinimum":0,"maximum":8},"head_tilt":{"type":"number","exclusiveMinimum":0,"maximum":0.05}}}
  }
}
